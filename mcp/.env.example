# Environment variables referenced by the configs in mcp/servers/*/mcp.json.
# Only set the ones for servers you actually enabled. Never commit real values.
#
# Claude Code expands ${VAR} from the environment it was launched in. It does
# NOT read .env by itself. Load these via your shell profile, direnv, or the
# "env" block of .claude/settings.local.json (keep that file gitignored).

# github — fine-grained personal access token, grant only the repos/scopes needed
GITHUB_PERSONAL_ACCESS_TOKEN=

# supabase — project ref of a DEVELOPMENT project (never production)
SUPABASE_PROJECT_REF=

# memory — absolute path to the knowledge-graph file; keep it out of git
MEMORY_FILE_PATH=

# context7 — optional, only for higher rate limits / private repos
# CONTEXT7_API_KEY=

# dbhub — connection string, e.g. postgres://user:pass@host:5432/db or mysql://user:pass@host:3306/db
# Use a database user that only has SELECT rights.
DBHUB_DSN=

# mongodb — e.g. mongodb://user:pass@host:27017/db (read-only role recommended)
MDB_MCP_CONNECTION_STRING=

# kubernetes — no variable in the config itself, but point the shell at a dedicated
# read-only kubeconfig before launching the agent:
# KUBECONFIG=/path/to/readonly-kubeconfig

# datadog — MCP endpoint for YOUR Datadog site (see servers/datadog/README.md)
DATADOG_MCP_URL=

# portainer — homelab/non-production only. MINOR must match your Portainer instance, e.g. 2.45
PORTAINER_MCP_MINOR=
PORTAINER_URL=
PORTAINER_API_KEY=

# postman — API key for the narrowest workspace that works
POSTMAN_API_KEY=

# openapi — one set per API server entry
API_BASE_URL=
OPENAPI_SPEC_PATH=
# optional, comma-separated Key:Value pairs, e.g. Authorization:Bearer xxx
API_HEADERS=
